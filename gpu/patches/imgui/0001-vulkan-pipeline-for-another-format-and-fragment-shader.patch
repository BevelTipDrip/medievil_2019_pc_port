+// gow3: a pipeline like the main one (layout, vertex input, blending) for another colour format and
+// fragment shader: the HDR10 overlay (gow3_overlay.cpp). The caller owns and destroys it.
+VkPipeline ImGui_ImplVulkan_CreatePipelineForFormat(VkFormat color_format, const VkShaderModuleCreateInfo* frag_info)
+{
+    ImGui_ImplVulkan_Data* bd = ImGui_ImplVulkan_GetBackendData();
+    ImGui_ImplVulkan_InitInfo* v = &bd->VulkanInitInfo;
+    ImGui_ImplVulkan_CreateShaderModules(v->Device, v->Allocator);
+    VkShaderModule frag = VK_NULL_HANDLE;
+    if (vkCreateShaderModule(v->Device, frag_info, v->Allocator, &frag) != VK_SUCCESS)
+        return VK_NULL_HANDLE;
+    const VkShaderModule main_frag = bd->ShaderModuleFrag;
+    bd->ShaderModuleFrag = frag;
+    ImGui_ImplVulkan_PipelineInfo info = v->PipelineInfoMain;
+    info.PipelineRenderingCreateInfo.colorAttachmentCount = 1;
+    info.PipelineRenderingCreateInfo.pColorAttachmentFormats = &color_format;
+    VkPipeline pipeline = ImGui_ImplVulkan_CreatePipeline(v->Device, v->Allocator, v->PipelineCache, &info);
+    bd->ShaderModuleFrag = main_frag;
+    vkDestroyShaderModule(v->Device, frag, v->Allocator);
+    return pipeline;
+}
